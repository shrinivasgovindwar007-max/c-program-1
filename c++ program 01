#include <iostream>
using namespace std;

int main() {
    int A[5], B[5], C[5];

    cout << "Enter 5 elements of first array: ";
    for (int i = 0; i < 5; i++) {
        cin >> A[i];
    }

    cout << "Enter 5 elements of second array: ";
    for (int i = 0; i < 5; i++) {
        cin >> B[i];
    }

    // Adding corresponding elements
    for (int i = 0; i < 5; i++) {
        C[i] = A[i] + B[i];
    }

    cout << "Resultant array: ";
    for (int i = 0; i < 5; i++) {
        cout << C[i] << " ";
    }

    return 0;
}
